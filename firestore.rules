rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helpers
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "none");
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ["safeness.c.a@gmail.com", "deuwyrobert@gmail.com"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         userRole() in ["admin", "superadmin", "ceo", "gestor"])
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ["safeness.c.a@gmail.com", "deuwyrobert@gmail.com"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         userRole() in ["superadmin", "admin"])
      );
    }

    function isApproved() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("status", "approved") == "approved";
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasPermission(permission) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data
          .get('permissions', {}).get(permission, false) == true;
    }

    function canManageData() {
      return isAdmin() || hasPermission('data:import') || hasPermission('data:assign');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProject(data) {
      return (data.get('clientId', '') is string || data.get('client', '') is string) &&
             data.name is string && data.name.size() > 0 &&
             data.status in ['Planificación', 'En ejecución', 'En riesgo', 'Finalizado'];
    }

    function isValidInvoice(data) {
      return (data.get('clientId', '') is string || data.get('client', '') is string) &&
             data.amount is number &&
             data.status in ['Pendiente', 'Pagada', 'Vencida', 'Cancelada'];
    }

    function isValidTimeLog(data) {
      return data.projectId is string &&
             data.hours is number &&
             (data.get('userUid', '') == request.auth.uid || data.get('userId', '') == request.auth.uid);
    }

    function isValidJob(data) {
      return data.title is string && data.title.size() > 0 &&
             data.department is string &&
             data.status in ['active', 'closed'];
    }

    // ===============================================================
    // Users
    // ===============================================================
    match /users/{userId} {
      allow read:   if isAuthenticated() && (isUser(userId) || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'status', 'permissions', 'uid'])
      );
      allow delete: if isAdmin();
    }

    match /user_sessions/{sessionId} {
      allow read:   if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Clients
    // ===============================================================
    match /clients/{clientId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update: if isAdmin() ||
                       existing().get('createdBy', '') == request.auth.uid ||
                       existing().get('assignedTo', '') == request.auth.uid;
      allow delete: if isAdmin();

      match /{subcollection}/{document=**} {
        allow read:  if isAuthenticated();
        allow write: if isAdmin() ||
          get(/databases/$(database)/documents/clients/$(clientId)).data.get('createdBy', '') == request.auth.uid ||
          get(/databases/$(database)/documents/clients/$(clientId)).data.get('assignedTo', '') == request.auth.uid;
      }
    }

    match /leads/{leadId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /form_templates/{templateId} {
      allow read:   if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /client_interactions/{interactionId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /chat_messages/{messageId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                       (isAdmin() ||
                        existing().get('targetId', '') == request.auth.uid ||
                        existing().get('senderId', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Helpdesk
    // ===============================================================
    match /support_tickets/{ticketId} {
      allow get:  if isAdmin() || (isAuthenticated() && existing().userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && existing().userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Omnicanal & VoIP
    // ===============================================================
    match /omnichannel_threads/{threadId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create, update: if isAuthenticated();
        allow delete: if isAdmin();
      }
    }

    match /voip_call_history/{callId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /voip_providers/{providerId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /telnyx_phone_numbers/{numberId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /telnyx_agent_assignments/{assignmentId} {
      allow read:  if isAdmin() || existing().get('agentUid', '') == request.auth.uid;
      allow write: if isAdmin();
    }

    match /telnyx_sip_credentials/{sipId} {
      allow read: if isAdmin() || (isApproved() && existing().get('assignedTo', '') == request.auth.uid);
      allow create: if isAdmin() && incoming().get('assignedTo', null) == null;
      allow update: if isAdmin() && (
        existing().get('assignedTo', null) == null ||
        incoming().get('assignedTo', null) == null ||
        isSuperAdmin()
      );
      allow delete: if isAdmin();
    }

    match /esim_profiles/{profileId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /shared_whatsapp_chats/{chatId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /company_profiles/{profileId} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'industry', 'createdAt']) &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() < 200;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /call_dispositions/{dispositionId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Reclutamiento
    // ===============================================================
    match /candidates/{candidateId} {
      allow read:   if isAuthenticated();
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow get, list:      if true;
      allow create, update: if isAdmin() && isValidJob(incoming());
      allow delete:         if isAdmin();
    }

    // ===============================================================
    // Data / telemarketing — deny by default, operator sees assigned records only
    // ===============================================================
    match /dataBatches/{batchId} {
      allow read: if isAdmin();
      allow create: if canManageData() && incoming().get('createdBy', '') == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /dataRecords/{recordId} {
      allow get, list: if isAdmin() ||
        (isAuthenticated() && existing().get('assignedToUid', '') == request.auth.uid);
      allow create: if canManageData() && incoming().get('createdBy', '') == request.auth.uid;
      allow update: if isAdmin() ||
        (isAuthenticated() &&
         existing().get('assignedToUid', '') == request.auth.uid &&
         incoming().get('assignedToUid', '') == request.auth.uid &&
         incoming().diff(existing()).affectedKeys()
           .hasOnly(['status', 'updatedAt', 'lastUpdatedBy', 'lastCallAt']));
      allow delete: if isAdmin();
    }

    match /dataAssignments/{assignmentId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && existing().get('operatorUid', '') == request.auth.uid);
      allow create: if canManageData() && incoming().get('assignedBy', '') == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /regions/{regionId} {
      allow read: if isAdmin() || hasPermission('data:read');
      allow create, update, delete: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if isAdmin() || hasPermission('data:read');
      allow create, update, delete: if isAdmin();
    }

    // Custom roles and permission definitions are administrator-managed only.
    match /customRoles/{roleId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /roleAssignments/{assignmentId} {
      allow read: if isAdmin() || existing().get('userUid', '') == request.auth.uid;
      allow create, update, delete: if isSuperAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && incoming().get('actorUid', '') == request.auth.uid;
      allow update, delete: if false;
    }

    // ===============================================================
    // B2B, suscripciones, academia
    // ===============================================================
    match /b2b_entities/{entityId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /academic_progress/{progressId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // Finance settings are explicitly scoped; do not expose the whole settings collection.
    match /settings/billing {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /settings/payroll {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /settings/appearance {
      allow read:  if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /settings/voip_providers {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /settings/integrations {
      allow read, write: if isSuperAdmin() || isAdmin();
      match /{subcollection}/{docId} {
        allow read, write: if isSuperAdmin() || isAdmin();
      }
    }

    match /settings_integrations/{integrationId} {
      allow read, write: if isSuperAdmin() || isAdmin();
    }

    // ===============================================================
    // Integraciones
    // ===============================================================
    match /integrations/{integrationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /integration_test_logs/{logId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ===============================================================
    // Auditoría & Seguridad
    // ===============================================================
    match /audit_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.get('actorUid', request.auth.uid) == request.auth.uid;
      allow update, delete: if false;
    }

    match /security_alerts/{alertId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /automation_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /automation_logs/{logId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /collaborators/{collaboratorId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /prospects/{prospectId} {
      allow read:   if isAdmin() || existing().get('ownerId', '') == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow update: if isAdmin() || existing().get('ownerId', '') == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Proyectos, facturación & control horario
    // ===============================================================
    match /projects/{projectId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && isValidProject(incoming());
      allow update: if isAuthenticated() && isValidProject(incoming());
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && isValidInvoice(incoming());
      allow update: if isAuthenticated() && isValidInvoice(incoming());
      allow delete: if isAdmin();
    }

    // Expenses feed the accounting ledger and accounts payable.
    // Reads follow invoice visibility; only finance administrators can create or settle liabilities.
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() &&
        incoming().amount is number && incoming().amount > 0 &&
        incoming().get('currency', '') in ['BRL', 'USD'] &&
        incoming().get('status', '') in ['Pendiente', 'Pagada', 'Vencida', 'Cancelada'];
      allow update: if isAdmin() &&
        incoming().amount is number && incoming().amount > 0 &&
        incoming().get('currency', '') in ['BRL', 'USD'] &&
        incoming().get('status', '') in ['Pendiente', 'Pagada', 'Vencida', 'Cancelada'];
      allow delete: if isSuperAdmin();
    }

    match /time_logs/{logId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && isValidTimeLog(incoming());
      allow update: if isAuthenticated() &&
                       (isAdmin() ||
                        (existing().get('userUid', '') == request.auth.uid && isValidTimeLog(incoming())));
      allow delete: if isAdmin();
    }

    match /automation_workflows/{workflowId} {
      allow read, write: if isAdmin();
    }

    match /system_events/{eventId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /system_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ===============================================================
    // Asistencia & permisos
    // ===============================================================
    match /attendance_logs/{logId} {
      allow read:   if isAdmin() ||
                       (isAuthenticated() && (existing().get('userId', '') == request.auth.uid || existing().get('userUid', '') == request.auth.uid));
      allow create: if isAuthenticated() && (incoming().get('userId', '') == request.auth.uid || incoming().get('userUid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /absence_requests/{requestId} {
      allow read:   if isAdmin() ||
                       (isAuthenticated() && (existing().get('userId', '') == request.auth.uid || existing().get('userUid', '') == request.auth.uid));
      allow create: if isAuthenticated() && (incoming().get('userId', '') == request.auth.uid || incoming().get('userUid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read:   if isAdmin() || existing().get('ownerId', '') == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow update: if isAdmin() || existing().get('ownerId', '') == request.auth.uid;
      allow delete: if isAdmin() || existing().get('ownerId', '') == request.auth.uid;
    }

    match /documents/{documentId} {
      allow read:   if isAdmin() || existing().get('ownerId', '') == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow update: if isAdmin() || existing().get('ownerId', '') == request.auth.uid;
      allow delete: if isAdmin() || existing().get('ownerId', '') == request.auth.uid;
    }

    match /settings/telnyx_config {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===============================================================
    // Deny-all
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
