rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helpers
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApproved() {
      return hasUserProfile() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("status", "pending") == "approved";
    }

    function userRole() {
      return hasUserProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "none")
        : "none";
    }

    function isSuperAdmin() {
      // The approved Firestore profile is authoritative. Requiring a matching custom
      // claim here can deny a valid SuperAdmin while Firebase tokens are stale.
      return isApproved() && userRole() == "superadmin";
    }

    function isAdmin() {
      return isApproved() && (
        isSuperAdmin() || userRole() in ["admin", "ceo", "gestor"]
      );
    }

    function hasPermission(permissionKey) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let permissions = profile.get("permissions", {});
      return isSuperAdmin() || (isApproved() && (
        (permissions.keys().hasAny([permissionKey]) && permissions.get(permissionKey, false) == true) ||
        (!permissions.keys().hasAny([permissionKey]) && (
          userRole() in ["admin", "ceo"] ||
          (userRole() == "gestor" && permissionKey in ["dashboard", "tlmk_sales", "collections", "reports", "team_management", "calendar", "chat", "clients", "operations"]) ||
          (userRole() == "supervisor" && permissionKey in ["dashboard", "tlmk_sales", "dialer", "collections", "calendar", "chat", "clients", "reports", "team_management"]) ||
          (userRole() == "tlmk" && permissionKey in ["dashboard", "tlmk_sales", "dialer", "calendar", "chat", "clients"]) ||
          (userRole() in ["agente", "sales"] && permissionKey in ["dashboard", "tlmk_sales", "dialer", "calendar", "chat", "clients"]) ||
          (userRole() == "rrhh" && permissionKey in ["dashboard", "talent", "payroll", "calendar", "chat"]) ||
          (userRole() == "collaborator" && permissionKey in ["dashboard", "operations", "calendar", "chat", "documents"]) ||
          (userRole() == "cliente" && permissionKey in ["academy", "billing", "clients", "chat"]) ||
          (userRole() == "alumno" && permissionKey in ["academy", "chat"])
        ))
      ));
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProject(data) {
      return (data.get('clientId', '') is string || data.get('client', '') is string) &&
             data.name is string && data.name.size() > 0 &&
             data.status in ['Planificación', 'En ejecución', 'En riesgo', 'Finalizado'];
    }

    function isValidInvoice(data) {
      return (data.get('clientId', '') is string || data.get('client', '') is string) &&
             data.amount is number &&
             data.status in ['Pendiente', 'Pagada', 'Vencida', 'Cancelada'];
    }

    function isValidTimeLog(data) {
      return data.projectId is string &&
             data.hours is number &&
             (data.get('userUid', '') == request.auth.uid || data.get('userId', '') == request.auth.uid);
    }

    function isValidJob(data) {
      return data.title is string && data.title.size() > 0 &&
             data.department is string &&
             data.status in ['active', 'closed'];
    }

    // ===============================================================
    // Users
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (isUser(userId) || isAdmin());
      // Only trusted server APIs may create profiles or change approval/role/permissions.
      allow create: if false;
      allow update: if isUser(userId) && isApproved() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'status', 'permissions', 'uid', 'assignedCallerId', 'assignedSipCredentialId']);
      allow delete: if isSuperAdmin();
    }

    match /sip_assignments/{credentialId} {
      allow read: if isSuperAdmin() || isAdmin() ||
        (isApproved() && resource.data.get('assignedTo', '') == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /user_sessions/{sessionId} {
      allow read: if isApproved() && (isUser(resource.data.get('uid', '')) || isAdmin());
      allow create, update: if isApproved() && request.resource.data.get('uid', request.auth.uid) == request.auth.uid;
      allow delete: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Clients
    // ===============================================================
    match /clients/{clientId} {
      allow read: if hasPermission('clients');
      allow create: if hasPermission('clients') && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update: if hasPermission('clients') && (isAdmin() || existing().get('createdBy', '') == request.auth.uid || existing().get('assignedTo', '') == request.auth.uid);
      allow delete: if isAdmin();

      match /{subcollection}/{document=**} {
        allow read: if hasPermission('clients');
        allow write: if hasPermission('clients') && (isAdmin() ||
          get(/databases/$(database)/documents/clients/$(clientId)).data.get('createdBy', '') == request.auth.uid ||
          get(/databases/$(database)/documents/clients/$(clientId)).data.get('assignedTo', '') == request.auth.uid);
      }
    }

    match /leads/{leadId} {
      allow read, create, update: if hasPermission('tlmk_sales');
      allow delete: if isAdmin();
    }

    match /form_templates/{templateId} {
      allow read: if hasPermission('operations');
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
      allow delete: if isAdmin();
    }

    match /client_interactions/{interactionId} {
      allow read, create, update: if hasPermission('clients');
      allow delete: if isAdmin();
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, create, update: if hasPermission('operations');
      allow delete: if isApproved() && hasPermission('operations');
    }

    match /chat_messages/{messageId} {
      allow read: if hasPermission('chat');
      allow create: if hasPermission('chat');
      allow update: if hasPermission('chat') &&
                       (isAdmin() || existing().get('targetId', '') == request.auth.uid || existing().get('senderId', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Helpdesk
    // ===============================================================
    match /support_tickets/{ticketId} {
      allow get: if isAdmin() || (isApproved() && existing().userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isApproved() && existing().userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Omnicanal & VoIP
    // ===============================================================
    match /omnichannel_threads/{threadId} {
      allow read, create, update: if hasPermission('chat');
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create, update: if hasPermission('chat');
        allow delete: if isAdmin();
      }
    }

    match /voip_call_history/{callId} {
      allow read, create, update: if hasPermission('dialer');
      allow delete: if isAdmin();
    }

    match /voip_providers/{providerId} {
      allow read: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /telnyx_phone_numbers/{numberId} {
      allow read: if hasPermission('dialer');
      allow write: if isSuperAdmin();
    }

    match /telnyx_agent_assignments/{assignmentId} {
      // An agent can read only their own assignment document (document ID = UID).
      // Admin Hub remains the only client-side writer.
      allow read: if isSuperAdmin() || isAdmin() ||
        (isApproved() && hasPermission('dialer') &&
          (assignmentId == request.auth.uid || existing().get('agentUid', '') == request.auth.uid));
      allow write: if isSuperAdmin();
    }

    match /telnyx_sip_credentials/{sipId} {
      allow read: if isSuperAdmin() || isAdmin() ||
        (isApproved() && existing().get('assignedTo', '') == request.auth.uid);
      // Credential assignment lifecycle is server-only to avoid race conditions.
      allow create, update, delete: if isSuperAdmin();
    }

    // Token generation errors are written only by trusted server code using Admin SDK.
    match /telnyx_token_errors/{errorId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /esim_profiles/{profileId} {
      allow read: if hasPermission('dialer');
      allow create, update, delete: if isSuperAdmin();
    }

    match /shared_whatsapp_chats/{chatId} {
      allow read, create, update: if hasPermission('chat');
      allow delete: if isSuperAdmin();
    }

    match /company_profiles/{profileId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'industry', 'createdAt']) &&
                       request.resource.data.name is string && request.resource.data.name.size() < 200;
      allow update, delete: if isSuperAdmin();
    }

    match /appointments/{appointmentId} {
      allow read, create, update: if hasPermission('calendar');
      allow delete: if isAdmin();
      allow delete: if isAdmin();
    }

    match /call_dispositions/{dispositionId} {
      allow read, create, update: if hasPermission('dialer');
      allow delete: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Reclutamiento
    // ===============================================================
    match /candidates/{candidateId} {
      allow read:   if isAuthenticated();
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow get, list:      if true;
      allow create, update: if isAdmin() && isValidJob(incoming());
      allow delete:         if isAdmin();
    }

    // ===============================================================
    // B2B, suscripciones, academia
    // ===============================================================
    match /b2b_entities/{entityId} {
      allow read: if isApproved() && hasPermission('clients');
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isApproved() && hasPermission('billing');
      allow write: if isAdmin();
    }

    match /academic_progress/{progressId} {
      allow read: if hasPermission('academy');
      allow write: if isAdmin();
    }

    match /settings/appearance {
      allow read:  if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /settings/voip_providers {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /settings/integrations {
      allow read, write: if isSuperAdmin() || isAdmin();
      match /{subcollection}/{docId} {
        allow read, write: if isSuperAdmin() || isAdmin();
      }
    }

    match /settings_integrations/{integrationId} {
      allow read, write: if isSuperAdmin() || isAdmin();
    }

    // ===============================================================
    // Integraciones
    // ===============================================================
    match /integrations/{integrationId} {
      allow read: if hasPermission('integrations');
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
      allow delete: if isAdmin();
    }

    match /integration_test_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ===============================================================
    // Auditoría & Seguridad
    // ===============================================================
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      // Audit events are written only by trusted server APIs using Firebase Admin SDK.
      allow create, update, delete: if false;
    }

    match /security_alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isApproved() && hasPermission('audits');
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /automation_rules/{ruleId} {
      allow read: if hasPermission('operations');
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
      allow delete: if isAdmin();
    }

    match /automation_logs/{logId} {
      allow read: if hasPermission('operations');
      allow create: if isApproved() && hasPermission('operations');
      allow update, delete: if false;
    }

    match /collaborators/{collaboratorId} {
      allow read: if hasPermission('team_management');
      allow write: if isAdmin();
    }

    match /prospects/{prospectId} {
      allow read: if isAdmin() || (isApproved() && hasPermission('tlmk_sales') && existing().get('ownerId', '') == request.auth.uid);
      allow create: if isApproved() && hasPermission('tlmk_sales') && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow update: if isAdmin() || (isApproved() && hasPermission('tlmk_sales') && existing().get('ownerId', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Proyectos, facturación & control horario
    // ===============================================================
    match /projects/{projectId} {
      allow read: if hasPermission('projects');
      allow create: if hasPermission('projects') && isValidProject(incoming());
      allow update: if hasPermission('projects') && isValidProject(incoming());
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if hasPermission('billing');
      allow create: if hasPermission('billing') && isValidInvoice(incoming());
      allow update: if hasPermission('billing') && isValidInvoice(incoming());
      allow delete: if isAdmin();
    }

    match /time_logs/{logId} {
      allow read: if hasPermission('operations');
      allow create: if hasPermission('operations') && isValidTimeLog(incoming());
      allow update: if isAuthenticated() &&
                       (isAdmin() ||
                        (existing().get('userUid', '') == request.auth.uid && isValidTimeLog(incoming())));
      allow delete: if isAdmin();
    }

    match /automation_workflows/{workflowId} {
      allow read, write: if isAdmin();
    }

    match /system_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isApproved() && hasPermission('audits');
      allow update, delete: if false;
    }

    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isApproved() && hasPermission('audits');
      allow update, delete: if false;
    }

    // ===============================================================
    // Asistencia & permisos
    // ===============================================================
    match /attendance_logs/{logId} {
      allow read: if isAdmin() ||
        (isApproved() && (existing().get('userId', '') == request.auth.uid || existing().get('userUid', '') == request.auth.uid));
      allow create: if isApproved() && (incoming().get('userId', '') == request.auth.uid || incoming().get('userUid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /absence_requests/{requestId} {
      allow read: if isAdmin() ||
        (isApproved() && (existing().get('userId', '') == request.auth.uid || existing().get('userUid', '') == request.auth.uid));
      allow create: if isApproved() && (incoming().get('userId', '') == request.auth.uid || incoming().get('userUid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: isApproved() && (isAdmin() || existing().get('ownerId', '') == request.auth.uid);
      allow create: if isApproved() && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow update: if isApproved() && (isAdmin() || existing().get('ownerId', '') == request.auth.uid);
      allow delete: if isApproved() && (isAdmin() || existing().get('ownerId', '') == request.auth.uid);
    }

    match /documents/{documentId} {
      allow read: isApproved() && (isAdmin() || (hasPermission('documents') && existing().get('ownerId', '') == request.auth.uid));
      allow create: if isApproved() && hasPermission('documents') && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow update: if isApproved() && (isAdmin() || (hasPermission('documents') && existing().get('ownerId', '') == request.auth.uid));
      allow delete: if isSuperAdmin() || (isApproved() && hasPermission('documents') && existing().get('ownerId', '') == request.auth.uid);
    }

    match /settings/telnyx_config {
      // Legacy shared JWT configuration is never readable by operators.
      allow read, write: if isSuperAdmin();
    }

    // ===============================================================
    // Deny-all
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
